{
  "name": "posthtml-parser",
  "version": "0.12.1",
  "description": "Parse HTML/XML to PostHTMLTree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posthtml/posthtml-parser.git"
  },
  "homepage": "https://github.com/posthtml/posthtml-parser#readme",
  "bugs": {
    "url": "https://github.com/posthtml/posthtml-parser/issues"
  },
  "author": "Ivan Voischev <voischev.ivan@ya.ru>",
  "contributors": [
    {
      "name": "Ivan Voischev",
      "email": "voischev.ivan@ya.ru"
    },
    {
      "name": "Ivan Demidov",
      "email": "scrum@posthtml.org"
    }
  ],
  "main": "dist",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "npm run build && npm run test:coverage",
    "test:unit": "node --test test/core.test.cjs",
    "test:coverage": "c8 node --test test/core.test.cjs",
    "test:package": "node test/package.cjs",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/types/tsconfig.json",
    "typecheck:minimum": "npm exec --yes --package=typescript@5.3.3 -- tsc --noEmit -p test/types/tsconfig.json",
    "check": "npm run build && npm run lint && npm run typecheck && npm run typecheck:minimum && npm run test:coverage && npm run test:package",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "html",
    "xml",
    "parser",
    "posthtml",
    "posthtmltree"
  ],
  "dependencies": {
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "types": "dist/index.d.ts"
}
